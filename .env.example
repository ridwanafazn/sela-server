# Application
APP_ENV=development
APP_NAME=sela-server
APP_PORT=8080

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Database
# DATABASE_URL is the pooled connection used by the API.
# DATABASE_URL_UNPOOLED is the direct connection used by migrations. When
# unset, migrations fall back to DATABASE_URL.
DATABASE_URL=postgres://sela:sela@localhost:5432/sela?sslmode=disable
DATABASE_URL_UNPOOLED=postgres://sela:sela@localhost:5432/sela?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_PING_TIMEOUT=2s

# HTTP server
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

# Health
HEALTH_CHECK_TIMEOUT=5s

# Authentication
# Local development only. Generate a unique 32+ character secret outside
# development and never commit it.
JWT_ACCESS_SECRET=local-development-only-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=sela-api
JWT_AUDIENCE=sela-mobile

# DB-backed authentication rate limits.
# RATE_LIMIT_SECRET falls back to JWT_ACCESS_SECRET when unset.
RATE_LIMIT_SECRET=
# Set to 1 when a single trusted proxy (Cloud Run) terminates connections and
# appends the client address to X-Forwarded-For. Keep 0 for direct connections.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
RATE_LIMIT_LOGIN_PER_MINUTE_IP=5
RATE_LIMIT_LOGIN_PER_HOUR_ACCOUNT=10
RATE_LIMIT_REGISTER_PER_HOUR_IP=3
RATE_LIMIT_REFRESH_PER_MINUTE_IP=30

# Integration tests create and drop disposable databases on this server.
TEST_DATABASE_URL=postgres://sela:sela@localhost:5432/sela_test?sslmode=disable

# AI providers
# Fake providers run locally without credentials and are deterministic for tests.
AI_PROVIDER=fake
AI_MODEL=fake-chat
# AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_TIMEOUT=60s
AI_MAX_RETRIES=3

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding-768
EMBEDDING_DIMENSION=768
# EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30s

# Vertex AI embeddings (EMBEDDING_PROVIDER=vertex).
# Uses Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_PROJECT_ID=
VERTEX_REGION=asia-southeast1
VERTEX_EMBEDDING_MODEL=text-embedding-004
# VERTEX_BASE_URL=   # override for tests or an emulator
